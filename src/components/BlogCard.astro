---
export interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  slug: string;
  category?: string;
}

const { title, description, date, tags = [], slug, category } = Astro.props;
const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="group h-full card-surface transition-colors hover:border-accent">
  <a href={`/blog/${slug}`} class="flex h-full flex-col p-5 transition-colors">
    <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-muted">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {category && (
        <span class="border border-accent/30 px-1.5 py-0.5 text-[10px] text-accent">{category}</span>
      )}
    </div>
    <h2 class="mb-2 text-base font-semibold leading-snug tracking-tight text-ink group-hover:text-accent transition-colors">
      {title}
    </h2>
    <p class="mb-3 line-clamp-2 text-sm leading-relaxed text-muted">
      {description}
    </p>
    {tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="border border-line px-2 py-0.5 text-xs text-muted">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>