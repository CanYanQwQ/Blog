---
import Icon from './Icon.astro';
import { footer as footerCfg, author, features } from '../config';
---

<footer class="mt-10 border-t border-line">
  <div class="flex flex-col items-center gap-3 py-6 text-sm text-muted md:flex-row md:justify-between">
    <p>&copy; {footerCfg.since}—{new Date().getFullYear()} {author.name}</p>
    {features.rss && (
      <div class="flex items-center gap-4">
        <a
          href="/rss.xml"
          class="flex items-center gap-1 text-muted hover:text-accent transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="RSS"
        >
          <Icon name="rss" size={14} />
          <span>RSS</span>
        </a>
      </div>
    )}
    {footerCfg.customText && (
      <span>{footerCfg.customText}</span>
    )}
  </div>
</footer>