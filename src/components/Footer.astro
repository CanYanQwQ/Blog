---
import Icon from './Icon.astro';
import { footer as footerCfg, author, features } from '../config';
---

<footer class="border-t border-black">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-3 px-4 py-6 text-sm text-gray-500 md:flex-row md:justify-between">
    <p>&copy; {footerCfg.since}—{new Date().getFullYear()} {author.name}</p>
    {features.rss && (
      <div class="flex items-center gap-4">
        <a
          href="/rss.xml"
          class="flex items-center gap-1 hover:text-black transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="RSS"
        >
          <Icon name="rss" size={14} />
          <span class="text-xs uppercase tracking-wider">RSS</span>
        </a>
      </div>
    )}
    {footerCfg.customText && (
      <span class="text-xs">{footerCfg.customText}</span>
    )}
  </div>
</footer>