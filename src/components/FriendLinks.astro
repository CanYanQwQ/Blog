---
import Icon from './Icon.astro';

export interface Friend {
  name: string;
  url: string;
  description?: string;
}

export interface Props {
  friends: Friend[];
}

const { friends } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2">
  {friends.map((friend) => (
    <a
      href={friend.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group card-surface flex items-center gap-3 p-4 transition-colors hover:border-accent"
    >
      <div class="flex h-10 w-10 items-center justify-center rounded-inner border border-line bg-accent text-accent-foreground">
        <Icon name="link" size={20} />
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="text-sm font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">{friend.name}</h3>
        {friend.description && (
          <p class="truncate text-xs text-muted">{friend.description}</p>
        )}
      </div>
      <Icon name="arrow-up-right" size={16} class="shrink-0 text-muted group-hover:text-accent" />
    </a>
  ))}
</div>