  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['lucide', className]}
>
  {icon.map(([tag, attrs]) => {
    const Tag = tag as 'path' | 'circle' | 'rect' | 'line' | 'polyline' | 'polygon';
    return <Tag {...attrs} />;
  })}
</svg>