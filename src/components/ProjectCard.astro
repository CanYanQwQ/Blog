---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  stars: number;
  forks: number;
}

const { title, description, tech, repo, stars, forks } = Astro.props;
---

<article class="group border border-black bg-white p-6">
  <h3 class="mb-2 text-lg font-bold tracking-tight">
    {title}
  </h3>
  <p class="mb-4 text-sm leading-relaxed text-gray-500">
    {description}
  </p>
  {tech.length > 0 && (
    <div class="mb-4 flex flex-wrap gap-1.5">
      {tech.map((t) => (
        <span class="border border-black px-2 py-0.5 text-xs uppercase tracking-wider">
          {t}
        </span>
      ))}
    </div>
  )}
  <a
    href={repo}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 text-xs uppercase tracking-wider underline underline-offset-4 transition-colors hover:text-gray-500"
  >
    <Icon name="globe" size={14} />
    GitHub
    {stars > 0 && <span class="border border-current px-1 text-[10px]">&#9733; {stars}</span>}
    {forks > 0 && <span class="text-[10px] text-gray-400">⑂ {forks}</span>}
  </a>
</article>