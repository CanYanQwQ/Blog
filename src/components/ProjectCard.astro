---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  stars: number;
  forks: number;
}

const { title, description, tech, repo, stars, forks } = Astro.props;
---

<article class="group card-surface p-6 transition-colors hover:border-accent">
  <h3 class="mb-2 text-lg font-semibold tracking-tight text-ink">
    {title}
  </h3>
  <p class="mb-4 text-sm leading-relaxed text-muted">
    {description}
  </p>
  {tech.length > 0 && (
    <div class="mb-4 flex flex-wrap gap-1.5">
      {tech.map((t) => (
        <span class="border border-line px-2 py-0.5 text-xs text-muted">
          {t}
        </span>
      ))}
    </div>
  )}
  <a
    href={repo}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 text-xs text-accent transition-colors hover:text-ink"
  >
    <Icon name="globe" size={14} />
    GitHub
    {stars > 0 && <span class="flex items-center gap-1 border border-line px-1.5 py-0.5 text-[11px] text-ink"><Icon name="star" size={11} />{stars}</span>}
    {forks > 0 && <span class="flex items-center gap-1 text-[11px] text-muted"><Icon name="git-fork" size={11} />{forks}</span>}
  </a>
</article>