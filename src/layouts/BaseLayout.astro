---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, author, seo, features, theme, footer as footerCfg } from '../config';
import { marked } from 'marked';

export interface Props {
  title: string;
  description?: string;
  authorName?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Search scope: 'all' | 'blog' | 'projects' | 'notes' | 'archive' */
  searchScope?: string;
}

const {
  title,
  description,
  authorName,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  searchScope = 'all',
} = Astro.props;
const desc = description || site.description;
const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const imageUrl = seo.ogImage ? new URL(seo.ogImage, site.url).toString() : undefined;
const pageAuthor = authorName || author.name;
const publishedIso = publishedTime?.toISOString();
const modifiedIso = modifiedTime?.toISOString() || publishedIso;
const robotsContent = noindex ? 'noindex, follow' : 'index, follow';

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ogType === 'article' ? 'BlogPosting' : 'WebPage',
  name: title,
  description: desc,
  url: canonicalUrl,
  inLanguage: site.lang,
  ...(ogType === 'article' && {
    headline: title,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    author: {
      '@type': 'Person',
      name: pageAuthor,
      ...(author.website && { url: author.website }),
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
  }),
}).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang={site.lang} data-theme-default={theme.default} class={theme.default === 'dark' ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={desc} />
    <meta name="author" content={pageAuthor} />
    <meta name="robots" content={robotsContent} />
    <title>{title} — {site.title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content={site.lang.replace('-', '_')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.title} />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {ogType === 'article' && publishedIso && (
      <>
        <meta property="article:published_time" content={publishedIso} />
        <meta property="article:modified_time" content={modifiedIso} />
        <meta property="article:author" content={pageAuthor} />
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <script is:inline>
      (function() {
        // 'dark' | 'light' | 'auto' — set from config on the <html> element
        var DEFAULT = document.documentElement.getAttribute('data-theme-default') || 'dark';
        var stored = localStorage.getItem('theme');
        var prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var useDark;
        if (stored === 'light' || stored === 'dark') {
          // User has explicitly chosen — honour it
          useDark = stored === 'dark';
        } else if (DEFAULT === 'dark') {
          // Default dark, regardless of system
          useDark = true;
        } else if (DEFAULT === 'light') {
          useDark = false;
        } else {
          // 'auto' — follow system
          useDark = prefers;
        }
        if (useDark) {
          document.documentElement.classList.add('dark');
        } else {
          // The server renders class="dark" when theme.default is 'dark', so a
          // visitor who chose light must have it removed here — adding only
          // would leave every page dark until they clicked the toggle.
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col lg:flex-row">
    <Header />
    <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-8">
      <slot />
      <Footer />
    </main>
  </body>
</html>