---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendLinks from '../components/FriendLinks.astro';
import { getCollection } from 'astro:content';

const allFriends = await getCollection('friends');
const friends = allFriends.map((f) => ({
  name: f.data.name,
  url: f.data.url,
  description: f.data.description,
}));
---

<BaseLayout title="友链" description="友情链接" searchScope="all">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-2xl font-bold uppercase tracking-tighter">友链</h1>
    <span class="text-xs uppercase tracking-wider text-gray-500">
      共 {friends.length} 个站点
    </span>
  </div>

  {friends.length > 0 ? (
    <FriendLinks friends={friends} />
  ) : (
    <div class="border border-black p-12 text-center">
      <p class="text-sm text-gray-500">暂无友链</p>
    </div>
  )}
</BaseLayout>