---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalSearch from '../components/GlobalSearch.vue';
import { getCollection } from 'astro:content';
import { Marked } from 'marked';
import { buildSearchIndex, filterByScope } from '../lib/search';

const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const searchItems = filterByScope(await buildSearchIndex(), 'notes');

// Image renderer wraps each image for golden-ratio sizing. It lives on a local
// instance because `marked` is a module-global singleton and `marked.use()`
// cannot be undone — mutating the shared one leaks into other prerendered pages.
const marked = new Marked({
  renderer: {
    image({ href, title, text }) {
      const titleAttr = title ? ` title="${title}"` : '';
      return `<div class="note-img-wrap"><img src="${href}" alt="${text}"${titleAttr} loading="lazy" /></div>`;
    },
  },
});

const notesHtml = await Promise.all(
  sortedNotes.map(async (note) => ({
    slug: note.id,
    date: note.data.date,
    html: marked.parse(note.body || ''),
  }))
);
---

<BaseLayout title="说说" description="日常随想" searchScope="notes">
  <div class="mb-8 flex items-end justify-between border-b border-line pb-6">
    <h1 class="font-display text-3xl font-semibold tracking-tight text-ink">说说</h1>
    <span class="text-sm text-muted">
      共 {sortedNotes.length} 条
    </span>
  </div>

  <div class="mb-8">
    <GlobalSearch client:load items={JSON.stringify(searchItems)} />
  </div>

  {notesHtml.length > 0 ? (
    <div class="space-y-3">
      {notesHtml.map((note) => (
        <div class="card-surface p-4 transition-colors hover:border-accent">
          <time class="mb-1 block text-xs text-muted">
            {note.date.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
            })}
          </time>
          <div class="note-content prose prose-sm max-w-none" set:html={note.html}></div>
        </div>
      ))}
    </div>
  ) : (
    <div class="card-surface p-12 text-center">
      <p class="text-sm text-muted">暂无说说</p>
    </div>
  )}
</BaseLayout>

<script>
  // Detect image orientation and apply golden ratio sizing
  document.addEventListener('DOMContentLoaded', () => {
    const wraps = document.querySelectorAll('.note-img-wrap');
    wraps.forEach((wrap) => {
      const img = wrap.querySelector('img');
      if (!img) return;
      if (img.complete) {
        applyGoldenRatio(wrap, img);
      } else {
        img.addEventListener('load', () => applyGoldenRatio(wrap, img));
      }
    });
  });

  function applyGoldenRatio(wrap, img) {
    const isLandscape = img.naturalWidth > img.naturalHeight;
    wrap.classList.add(isLandscape ? 'landscape' : 'portrait');
  }
</script>