---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.vue';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.filter((post) => !post.data.draft).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  slug: post.id,
}));
---

<BaseLayout title="搜索" description="搜索文章" noindex>
  <div class="mb-8">
    <h1 class="text-2xl font-bold uppercase tracking-tighter">搜索</h1>
  </div>

  <SearchBar client:load posts={JSON.stringify(posts)} />
</BaseLayout>